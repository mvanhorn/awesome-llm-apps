import json, urllib.request
req = urllib.request.Request(
    'http://127.0.0.1:8766/page-watch/trigger',
    data=json.dumps({'dry_run': True, 'live': False}).encode(),
    headers={'Content-Type': 'application/json'},
    method='POST',
)
data = json.loads(urllib.request.urlopen(req).read())
print('dry_run =', data['dry_run'])
print('delivery.sent =', data['delivery']['sent'])
print('delivery.status =', data['delivery']['status'])
print('nothing sent:', data['delivery']['sent'] is False)
